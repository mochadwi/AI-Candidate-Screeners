{
  "info": {
    "name": "AI Candidate Screeners API",
    "description": "Comprehensive API documentation for AI-powered CV evaluation system",
    "version": "1.1.0",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Upload Both CV and Project Files",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "multipart/form-data",
            "type": "text"
          }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "cv",
              "type": "file",
              "src": "/path/to/cv.pdf",
              "description": "CV file to upload (PDF only, max 10MB)"
            },
            {
              "key": "project",
              "type": "file",
              "src": "/path/to/project.pdf",
              "description": "Project report file to upload (PDF only, max 10MB)"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/upload/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "upload",
            ""
          ]
        }
      },
      "response": []
    },
    {
      "name": "Create Evaluation Job",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"{{jobTitle}}\",\n  \"cvFileId\": \"{{cvFileId}}\",\n  \"projectFileId\": \"{{projectFileId}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/evaluate/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "evaluate",
            ""
          ]
        }
      },
      "response": []
    },
    {
      "name": "Get Job Result",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/result/{{jobId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "result",
            "{{jobId}}"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Basic Health Check",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/health/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health",
            ""
          ]
        }
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "default"
    },
    {
      "key": "cvFileId",
      "value": "",
      "type": "default"
    },
    {
      "key": "projectFileId",
      "value": "",
      "type": "default"
    },
    {
      "key": "jobId",
      "value": "",
      "type": "default"
    },
    {
      "key": "jobTitle",
      "value": "Senior Backend Developer",
      "type": "default"
    }
  ]
}