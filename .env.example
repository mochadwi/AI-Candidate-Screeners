# Server Configuration
PORT=3000
NODE_ENV=development

# AI Configuration
# Choose your AI provider: 'openai' or 'zhipu'
AI_PROVIDER=openai

# Unified AI Configuration
# Works with both OpenAI and Zhipu AI (no need to change variable names)
AI_API_KEY=your_ai_api_key_here
AI_MODEL=gpt-3.5-turbo
# AI_BASE_URL is only needed for custom endpoints (e.g., Zhipu AI)
AI_BASE_URL=

# AI Advanced Configuration
# Request timeout in milliseconds (default: 30000 = 30 seconds)
AI_REQUEST_TIMEOUT=30000

# Testing & Simulation Configuration
# Simulate failures for testing error handling (default: false)
SIMULATE_FAILURES=false
# Failure rate when simulation is enabled (0.0 to 1.0, default: 0)
FAILURE_RATE=0

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Logging Configuration
LOG_LEVEL=info

# ChromaDB Configuration
# ChromaDB requires a server - start with: docker run -p 8000:8000 -v ./chroma_data:/chroma/chroma chromadb/chroma:latest
CHROMA_PATH=http://localhost:8000
