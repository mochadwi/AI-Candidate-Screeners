# Server Configuration
PORT=3000
NODE_ENV=development

# AI Configuration
# Choose your AI provider: 'openai' or 'zhipu'
AI_PROVIDER=openai

# Unified AI Configuration
# Works with both OpenAI and Zhipu AI (no need to change variable names)
AI_API_KEY=your_ai_api_key_here
AI_MODEL=gpt-3.5-turbo
# AI_BASE_URL is only needed for custom endpoints (e.g., Zhipu AI)
AI_BASE_URL=

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Logging Configuration
LOG_LEVEL=info